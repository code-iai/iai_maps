            def Scope "cabinet"
            {
                def "Actor_0000" (
                    prepend references = @./Assets/cabinet_A71cf8c99Bd8a4ab0847b101e3f6f9fa4/cabinet_A71cf8c99Bd8a4ab0847b101e3f6f9fa4_articulated.usda@
                )
                {
                    float3 xformOp:rotateXYZ = (0, -0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0.9000000134110451, 7.420769929885864, 1.0000000337955655)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    # === collision: the MJCF twin's shapes, not the asset's ===
                    #
                    # Every collider below is generated from
                    # ros2_ws/src/iai_maps/iai_garmi_apartment/mjcf/scene-bodies.xml --
                    # body "kitchen_cabinet" with its drawers, doors and handles -- by
                    # composing its class="collision" geoms through their <frame>s into map
                    # coordinates and back into each USD body's frame. MuJoCo box "size" is
                    # a half-extent, hence the 2x on the scales; its cylinders run along z,
                    # as USD's do.
                    #
                    # Each mesh keeps its geometry and loses its collider
                    # (physics:collisionEnabled = 0). The asset approximated every part as
                    # a convex hull or decomposition while the twin plans against these
                    # shapes, and the two disagreeing is what this removes. The sink stays
                    # open: the carcase's boxes are the basin's own walls and rim, their top
                    # faces at 0.945, which is the height KITCHEN_WORKTOP records.
                    #
                    # A handle is a collider of the door or drawer it sits on rather than a
                    # body of its own, so its cylinder is authored on that body.
                    #
                    # purpose = "guide" keeps these out of the render; enable
                    # Show By Type > Guide in the viewport to see them.
                    over "Static"
                    {
                        over "geom"
                        {
                            bool physics:collisionEnabled = 0
                        }

                        # MJCF body "kitchen_cabinet": 99 shapes
                        def Cube "collision_00" (
                            prepend apiSchemas = ["PhysicsCollisionAPI"]
                        )
                        {
                            double size = 1
                            token purpose = "guide"
                            quatf xformOp:orient = (1, 0, 0, 0)
                            float3 xformOp:scale = (0.018, 0.56, 0.8)
                            double3 xformOp:translate = (1.2363, 7.44207, 0.5)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                        }
                        def Cube "collision_01" (
                            prepend apiSchemas = ["PhysicsCollisionAPI"]
                        )
                        {
                            double size = 1
                            token purpose = "guide"
                            quatf xformOp:orient = (1, 0, 0, 0)
                            float3 xformOp:scale = (0.018, 0.56, 0.8)
                            double3 xformOp:translate = (1.6683, 7.44207, 0.5)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                        }
                        def Cube "collision_02" (
                            prepend apiSchemas = ["PhysicsCollisionAPI"]
                        )
                        {
                            double size = 1
                            token purpose = "guide"
                            quatf xformOp:orient = (1, 0, 0, 0)
                            float3 xformOp:scale = (0.414, 0.56, 0.018)
                            double3 xformOp:translate = (1.4523, 7.44207, 0.109)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                        }
                        def Cube "collision_03" (
                            prepend apiSchemas = ["PhysicsCollisionAPI"]
                        )
                        {
                            double size = 1
                            token purpose = "guide"
                            quatf xformOp:orient = (1, 0, 0, 0)
                            float3 xformOp:scale = (0.404, 0.016, 0.032)
                            double3 xformOp:translate = (1.4523, 7.17107, 0.884)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                        }
                        def Cube "collision_04" (
                            prepend apiSchemas = ["PhysicsCollisionAPI"]
                        )
                        {

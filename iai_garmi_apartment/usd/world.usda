                        # They are the same boxes the digital twin plans against, written
                        # by hand in
                        # ros2_ws/src/iai_maps/iai_garmi_apartment/mjcf/scene-bodies.xml
                        # (body "dining_table_0", class="collision"). The shipped
                        # convexDecomposition filled the space under the top and rounded
                        # the legs into it, so giskard refused reaches the render allowed
                        # and allowed ones it did not have.
                        #
                        # physics:collisionEnabled = 0 turns the mesh's own collider off
                        # while leaving it as the visual; the boxes sit under the same
                        # rigid body, so they are its collision shapes and its authored
                        # mass is spread over them. purpose = "guide" keeps them out of
                        # the render -- enable Show By Type > Guide to see them.
                        #
                        # The numbers are the MJCF's own, divided by this asset's
                        # xformOp:scale = (0.8439577, 1, 1): the MJCF carries real metres
                        # while children here are pre-scale, so the top's 1.3504 m becomes
                        # 1.6000802. MuJoCo's box "size" is a half-extent, hence the 2x.
                        # Static, the same way CoffeeTable above is: the rigid body the
                        # asset applies is *deleted* rather than disabled, so the five
                        # boxes below are plain static colliders and there is no mass or
                        # inertia on this prim at all. The table is furniture and nothing
                        # here is meant to shove it -- as a dynamic body the base brushing
                        # a leg moved it, and the twin never heard about it.
                        #
                        # Deleting beats disabling for a second reason: a prim that still
                        # carries PhysicsRigidBodyAPI with rigidBodyEnabled = 0 is counted
                        # by anything that scans the stage for rigid bodies but is missing
                        # from PhysX's tensor view, which shifted every index past it and
                        # took the simulator down on startup (see
                        # cram_vrb_lab.sim.scene_reset_bridge._is_enabled).
                        #
                        # The twin agrees: scene-bodies.xml gives this body a <freejoint/>,
                        # which MJCFParser turns into a passive Connection6DoF that adds no
                        # variable to giskard's QP, so no goal can drive the table there
                        # either.
                        over "body" (
                            delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                        )
                        {
                            bool physics:collisionEnabled = 0

                            # table top
                            def Cube "collision_00" (
                                prepend apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                                double size = 1
                                token purpose = "guide"
                                double3 xformOp:translate = (0.0, 0.0, 0.33)
                                float3 xformOp:scale = (1.6000802, 0.85, 0.1)
                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                            }

                            # leg +x +y
                            def Cube "collision_01" (
                                prepend apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                                double size = 1
                                token purpose = "guide"
                                double3 xformOp:translate = (0.7556066, 0.38, -0.05)
                                float3 xformOp:scale = (0.088867, 0.09, 0.66)
                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                            }

                            # leg +x -y
                            def Cube "collision_02" (
                                prepend apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                                double size = 1
                                token purpose = "guide"
                                double3 xformOp:translate = (0.7556066, -0.38, -0.05)
                                float3 xformOp:scale = (0.088867, 0.09, 0.66)
                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                            }

                            # leg -x +y
                            def Cube "collision_03" (
                                prepend apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                                double size = 1
                                token purpose = "guide"
                                double3 xformOp:translate = (-0.7556066, 0.38, -0.05)
                                float3 xformOp:scale = (0.088867, 0.09, 0.66)
                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                            }

                            # leg -x -y
                            def Cube "collision_04" (
                                prepend apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                                double size = 1
                                token purpose = "guide"
                                double3 xformOp:translate = (-0.7556066, -0.38, -0.05)
                                float3 xformOp:scale = (0.088867, 0.09, 0.66)
                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                            }
                        }
                    }
                }
            }


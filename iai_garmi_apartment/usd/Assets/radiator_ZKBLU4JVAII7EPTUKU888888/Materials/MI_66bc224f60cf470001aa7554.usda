#usda 1.0
(
    defaultPrim = "Materials"
)

def Scope "Materials" (
    kind = "Component"
)
{
    def Material "MI_66bc224f60cf470001aa7554"
    {
        token outputs:surface.connect = </Materials/MI_66bc224f60cf470001aa7554/Shader.outputs:out>

        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            float inputs:bump_factor
            float inputs:detail_bump_factor
            asset inputs:detail_normalmap_texture
            color3f inputs:diffuse_color_constant = (0.6306945, 0.6306945, 0.6306945)
            asset inputs:diffuse_texture
            color3f inputs:emissive_color
            asset inputs:emissive_color_texture
            float inputs:emissive_intensity
            bool inputs:enable_emission
            bool inputs:enable_opacity
            bool inputs:enable_opacity_texture
            bool inputs:flip_tangent_u
            bool inputs:flip_tangent_v
            float inputs:metallic_constant = 1
            asset inputs:metallic_texture
            float inputs:metallic_texture_influence
            asset inputs:normalmap_texture
            float inputs:opacity_constant
            asset inputs:opacity_texture
            float inputs:reflection_roughness_constant
            float inputs:reflection_roughness_texture_influence = 1
            asset inputs:reflectionroughness_texture = @./Textures/T_66bc224f60cf470001aa7554_roughness.jpg@ (
                colorSpace = "raw"
            )
            float inputs:specular_level
            float2 inputs:texture_scale = (6, 6)
            float2 inputs:texture_translate = (-2.5, -2.5)
            token outputs:out
        }
    }
}


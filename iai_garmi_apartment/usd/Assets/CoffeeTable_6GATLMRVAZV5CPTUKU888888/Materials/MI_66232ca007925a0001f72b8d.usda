#usda 1.0
(
    defaultPrim = "Materials"
)

def Scope "Materials" (
    kind = "Component"
)
{
    def Material "MI_66232ca007925a0001f72b8d"
    {
        token outputs:surface.connect = </Materials/MI_66232ca007925a0001f72b8d/Shader.outputs:out>

        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            float inputs:bump_factor = 1
            float inputs:detail_bump_factor
            asset inputs:detail_normalmap_texture
            color3f inputs:diffuse_color_constant = (0.023637852, 0.023637867, 0.023635264)
            asset inputs:diffuse_texture
            color3f inputs:emissive_color
            asset inputs:emissive_color_texture
            float inputs:emissive_intensity
            bool inputs:enable_emission
            bool inputs:enable_opacity
            bool inputs:enable_opacity_texture
            bool inputs:flip_tangent_u
            bool inputs:flip_tangent_v
            float inputs:metallic_constant
            asset inputs:metallic_texture = @./Textures/T_66232ca007925a0001f72b8d_metallic.jpg@ (
                colorSpace = "raw"
            )
            float inputs:metallic_texture_influence = 1
            asset inputs:normalmap_texture = @./Textures/T_66232ca007925a0001f72b8d_normal.jpg@ (
                colorSpace = "raw"
            )
            float inputs:opacity_constant
            asset inputs:opacity_texture
            float inputs:reflection_roughness_constant
            float inputs:reflection_roughness_texture_influence = 1
            asset inputs:reflectionroughness_texture = @./Textures/T_66232ca007925a0001f72b8d_roughness.jpg@ (
                colorSpace = "raw"
            )
            float inputs:specular_level = 0.5000145
            float2 inputs:texture_scale = (3, 3)
            float2 inputs:texture_translate = (-1, -1)
            token outputs:out
        }
    }
}


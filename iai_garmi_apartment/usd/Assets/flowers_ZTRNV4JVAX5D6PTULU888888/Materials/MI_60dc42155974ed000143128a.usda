#usda 1.0
(
    defaultPrim = "Materials"
)

def Scope "Materials" (
    kind = "Component"
)
{
    def Material "MI_60dc42155974ed000143128a"
    {
        token outputs:surface.connect = </Materials/MI_60dc42155974ed000143128a/Shader.outputs:out>

        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
            float inputs:cutout_opacity = 1
            asset inputs:cutout_opacity_texture
            bool inputs:enable_opacity = 1
            float inputs:frosting_roughness = 0
            color3f inputs:glass_color = (1, 1, 1)
            asset inputs:glass_color_texture
            float inputs:glass_ior = 1.325
            float inputs:normal_map_strength
            asset inputs:normal_map_texture
            color3f inputs:reflection_color = (0.1, 0.1, 0.1)
            asset inputs:roughness_texture
            float inputs:roughness_texture_influence
            float2 inputs:texture_scale
            float2 inputs:texture_translate
            token outputs:out
        }
    }
}


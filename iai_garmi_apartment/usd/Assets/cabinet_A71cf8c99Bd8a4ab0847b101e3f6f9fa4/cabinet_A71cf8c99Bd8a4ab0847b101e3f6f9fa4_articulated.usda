            uniform token physics:axis = "Z"
            rel physics:body0 = </cabinet_A71cf8c99Bd8a4ab0847b101e3f6f9fa4/Static>
            rel physics:body1 = </cabinet_A71cf8c99Bd8a4ab0847b101e3f6f9fa4/door_2>
            point3f physics:localPos0 = (1.66688, 7.15154, 0.4)
            # x = 0.96 * 1.6758: PhysX scales a joint's local frame by the body it
            # sits on, and door_2's 0.96 squeeze now lives on its mesh, not its body.
            point3f physics:localPos1 = (1.608768, 7.15154, 0.4)
            float physics:lowerLimit = 0
            float physics:upperLimit = 90
        }


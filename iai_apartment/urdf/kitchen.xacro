    <joint name="oven_area_right_drawer_small_joint" type="prismatic">
      <origin xyz="-0.01 0.0 0.17" rpy="0 0 3.14" />
      <parent link="oven_area_right" />
      <child link="oven_area_right_drawer_small" />
      <axis xyz="-1 0 0" />
      <limit effort="500.0" lower="0.0" upper="0.45" velocity="0.5" />

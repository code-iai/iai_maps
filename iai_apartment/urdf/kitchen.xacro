        <material name="white" />
      </visual>
      <collision>
        <geometry>
          <box size="0.534 0.568 0.02" />
        </geometry>
      </collision>
    </link>


    <!-- oven_area_right -->
    <joint name="oven_area_right_joint" type="fixed">
      <origin xyz="-0.163 0.51 0.975" />
      <parent link="side_A" />
      <child link="oven_area_right" />
    </joint>

    <link name="oven_area_right">
      <visual>
        <geometry>
          <mesh filename="package://iai_apartment/meshes/cabinet02/IAICabinet2W40H57.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://iai_apartment/meshes/cabinet02/IAICabinet2W40H57.obj" />
        </geometry>
      </collision>
    </link>

    <joint name="oven_area_right_door_out_joint" type="prismatic">
      <origin xyz="0.277 -0.19 0.0" rpy="0 0 3.14" />
      <parent link="oven_area_right" />
      <child link="oven_area_right_door_out_fancy" />
      <axis xyz="-1 0 0" />
      <limit effort="1.0" lower="0.0" upper="0.02" velocity="1.5708" />
      <mimic joint="oven_area_right_door_left_joint" multiplier="0.01" />
    </joint>

    <link name="oven_area_right_door_out_fancy" />

    <joint name="oven_area_right_door_left_joint" type="revolute">
      <parent link="oven_area_right_door_out_fancy" />
      <child link="oven_area_right_door" />
      <axis xyz="0 0 -1" />
      <limit effort="1000.0" lower="0.0" upper="1.5708" velocity="1.5708" />
